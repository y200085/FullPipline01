pipeline {

    agent any

    environment {
        APP_NAME = "hello-java"
        VERSION = "1.0.0"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Building branch: ${env.BRANCH_NAME}"
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo "Building Java application..."
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Test') {
            steps {
                echo "Running tests..."
                sh 'mvn test'
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'target/*.jar',
                                 fingerprint: true
            }
        }

        stage('Development Deployment') {
            when {
                branch 'development'
            }

            steps {
                echo "Deploying ${APP_NAME} to DEVELOPMENT..."
                sh '''
                    mkdir -p deploy/development
                    cp target/*.jar deploy/development/
                    echo "Development deployment completed."
                '''
            }
        }

        stage('Production Approval') {
            when {
                branch 'main'
            }

            steps {

                script {

                    def approval = input(
                        message: 'Deploy this build to PRODUCTION?',
                        ok: 'Deploy to Production',
                        submitter: 'admin'
                    )

                    echo "Production deployment approved by ${approval}"
                }
            }
        }

        stage('Production Deployment') {
            when {
                branch 'main'
            }

            steps {
                echo "Deploying ${APP_NAME} to PRODUCTION..."

                sh '''
                    mkdir -p deploy/production
                    cp target/*.jar deploy/production/
                    echo "Production deployment completed."
                '''
            }
        }
    }

    post {

        success {
            echo "Pipeline completed successfully."
        }

        failure {
            echo "Pipeline FAILED."
        }

        always {
            echo "Pipeline finished."
        }
    }
}